{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "note-taker",
  "identifier": "sk.annotation.note-taker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "note-taker",
        "width": 1100,
        "height": 750,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "linux": {
      "deb": {
        "depends": ["git"]
      }
    }
  }
}
